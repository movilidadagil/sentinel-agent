# ---- Nebius Token Factory (OpenAI-compatible) ----
# Create a key at https://studio.nebius.com/ and paste it here.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
# Large reasoning model for planning (Super/Ultra tier):
NEBIUS_PLANNER_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1
# Small, fast model for high-volume triage (Nano tier):
NEBIUS_TRIAGE_MODEL=nvidia/Llama-3_1-Nemotron-Nano-8B-v1

# ---- Tavily live threat intelligence ----
# Create a key at https://tavily.com/
TAVILY_API_KEY=

# ---- Safety: host allowlist (REQUIRED) ----
# Comma-separated hosts Sentinel is permitted to test. The agent fails closed
# for anything not listed here. Only add hosts you are AUTHORIZED to test.
ALLOWED_HOSTS=localhost,127.0.0.1
# Allow targets that resolve to private/loopback IPs (Juice Shop runs locally):
ALLOW_PRIVATE_TARGETS=true

# ---- Execution engine ----
REQUEST_TIMEOUT=15
MAX_CRAWL_PAGES=25
SENTINEL_USER_AGENT=Sentinel/0.1 (authorized-security-testing)
